<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab013.PassengerDialog"
        Title="Пассажир"
        Width="500"
        Height="400"
        Background="White"
        WindowStartupLocation="CenterOwner">
	<StackPanel Margin="20" Spacing="15" Background="White">
		<TextBlock Text="Имя:"/>
		<TextBox x:Name="FirstNameTextBox"/>
		
		<TextBlock Text="Фамилия:"/>
		<TextBox x:Name="LastNameTextBox"/>
		
		<TextBlock Text="Номер паспорта:"/>
		<TextBox x:Name="PassportNumberTextBox"/>
		
		<TextBlock Text="Телефон:"/>
		<TextBox x:Name="PhoneTextBox"/>
		
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
			<Button Content="OK" Click="Ok_Click" Width="80"/>
			<Button Content="Отмена" Click="Cancel_Click" Width="80"/>
		</StackPanel>
	</StackPanel>
</Window>

