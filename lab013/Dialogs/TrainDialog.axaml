<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab013.TrainDialog"
        Title="Поезд"
        Width="500"
        Height="350"
        Background="White"
        WindowStartupLocation="CenterOwner"
        MinWidth="500"
        MinHeight="350">
	<StackPanel Margin="20" Spacing="15" Background="White">
		<TextBlock Text="Номер поезда:"/>
		<TextBox x:Name="NumberTextBox"/>
		
		<TextBlock Text="Тип:"/>
		<ComboBox x:Name="TypeComboBox">
			<ComboBoxItem Content="Скоростной"/>
			<ComboBoxItem Content="Пассажирский"/>
			<ComboBoxItem Content="Грузовой"/>
		</ComboBox>
		
		<TextBlock Text="Вместимость:"/>
		<TextBox x:Name="CapacityTextBox"/>
		
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
			<Button Content="OK" Click="Ok_Click" Width="80"/>
			<Button Content="Отмена" Click="Cancel_Click" Width="80"/>
		</StackPanel>
	</StackPanel>
</Window>

