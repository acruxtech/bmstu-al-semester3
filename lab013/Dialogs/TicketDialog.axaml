<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab013.TicketDialog"
        Title="Билет"
        Width="600"
        Height="450"
        Background="White"
        WindowStartupLocation="CenterOwner">
	<ScrollViewer>
		<StackPanel Margin="20" Spacing="15" Background="White">
			<TextBlock Text="Маршрут:" FontWeight="Bold"/>
			<ComboBox x:Name="RouteComboBox" Height="35" MinHeight="35" MaxDropDownHeight="200"/>
			<TextBlock x:Name="RouteCountText" Text="" FontSize="10" Foreground="Gray" Margin="0,-5,0,0"/>
			
			<TextBlock Text="Пассажир:" FontWeight="Bold"/>
			<ComboBox x:Name="PassengerComboBox" Height="35" MinHeight="35" MaxDropDownHeight="200"/>
			<TextBlock x:Name="PassengerCountText" Text="" FontSize="10" Foreground="Gray" Margin="0,-5,0,0"/>
		
		<TextBlock Text="Номер места:"/>
		<TextBox x:Name="SeatNumberTextBox"/>
		
		<TextBlock Text="Цена:"/>
		<TextBox x:Name="PriceTextBox"/>
		
		<TextBlock Text="Дата покупки:"/>
		<DatePicker x:Name="PurchaseDatePicker"/>
		
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
				<Button Content="OK" Click="Ok_Click" Width="80"/>
				<Button Content="Отмена" Click="Cancel_Click" Width="80"/>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</Window>

