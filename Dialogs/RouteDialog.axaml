<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab013.RouteDialog"
        Title="Маршрут"
        Width="600"
        Height="550"
        Background="White"
        WindowStartupLocation="CenterOwner">
	<ScrollViewer>
		<StackPanel Margin="20" Spacing="15" Background="White">
		<TextBlock Text="Название:"/>
		<TextBox x:Name="NameTextBox"/>
		
		<TextBlock Text="Станция отправления:"/>
		<TextBox x:Name="DepartureStationTextBox"/>
		
		<TextBlock Text="Станция прибытия:"/>
		<TextBox x:Name="ArrivalStationTextBox"/>
		
		<TextBlock Text="Дата и время отправления (yyyy-MM-dd HH:mm):"/>
		<TextBox x:Name="DepartureTimeTextBox"/>
		
		<TextBlock Text="Дата и время прибытия (yyyy-MM-dd HH:mm):"/>
		<TextBox x:Name="ArrivalTimeTextBox"/>
		
		<TextBlock Text="Цена:"/>
		<TextBox x:Name="PriceTextBox"/>
		
		<TextBlock Text="Поезд:" FontWeight="Bold"/>
		<ComboBox x:Name="TrainComboBox" Height="35" MinHeight="35" MaxDropDownHeight="200"/>
		<TextBlock x:Name="TrainCountText" Text="" FontSize="10" Foreground="Gray" Margin="0,-5,0,0"/>
		
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
				<Button Content="OK" Click="Ok_Click" Width="80"/>
				<Button Content="Отмена" Click="Cancel_Click" Width="80"/>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</Window>

