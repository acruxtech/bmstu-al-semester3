@page
@model RailwayTickets.Pages.Stations.IndexModel
@{
    ViewData["Title"] = "Станции";
}

<h1>Станции</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить станцию</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Название</th>
        <th>Город</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Stations)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.City</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Изменить</a>
                <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>

