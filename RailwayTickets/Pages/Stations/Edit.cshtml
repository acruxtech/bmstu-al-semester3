@page "{id:int}"
@model RailwayTickets.Pages.Stations.EditModel
@{
    ViewData["Title"] = "Редактировать станцию";
}

<h1>Редактировать станцию</h1>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Station.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Station.Name" class="form-label"></label>
        <input asp-for="Station.Name" class="form-control" />
        <span asp-validation-for="Station.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Station.City" class="form-label"></label>
        <input asp-for="Station.City" class="form-control" />
        <span asp-validation-for="Station.City" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</form>


