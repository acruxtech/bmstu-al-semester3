@page "{id:int}"
@model RailwayTickets.Pages.Tickets.EditModel
@{
    ViewData["Title"] = "Редактировать билет";
}

<h1>Редактировать билет</h1>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Ticket.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Ticket.PassengerName" class="form-label"></label>
        <input asp-for="Ticket.PassengerName" class="form-control" />
        <span asp-validation-for="Ticket.PassengerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ticket.TrainId" class="form-label"></label>
        <select asp-for="Ticket.TrainId" class="form-select" asp-items="Model.TrainOptions">
            <option value="">Выберите поезд</option>
        </select>
        <span asp-validation-for="Ticket.TrainId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Ticket.FromStationId" class="form-label"></label>
            <select asp-for="Ticket.FromStationId" class="form-select" asp-items="Model.StationOptions">
                <option value="">Станция отправления</option>
            </select>
            <span asp-validation-for="Ticket.FromStationId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Ticket.ToStationId" class="form-label"></label>
            <select asp-for="Ticket.ToStationId" class="form-select" asp-items="Model.StationOptions">
                <option value="">Станция прибытия</option>
            </select>
            <span asp-validation-for="Ticket.ToStationId" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Ticket.SeatNumber" class="form-label"></label>
            <input asp-for="Ticket.SeatNumber" class="form-control" />
            <span asp-validation-for="Ticket.SeatNumber" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Ticket.Price" class="form-label"></label>
            <input asp-for="Ticket.Price" class="form-control" />
            <span asp-validation-for="Ticket.Price" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</form>


