@page "{id:int}"
@model RailwayTickets.Pages.Tickets.DeleteModel
@{
    ViewData["Title"] = "Удалить билет";
}

<h1>Удалить билет</h1>

<h4>Вы уверены, что хотите удалить этот билет?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-3">Пассажир</dt>
        <dd class="col-sm-9">@Model.Ticket?.PassengerName ?? ""</dd>
        <dt class="col-sm-3">Маршрут</dt>
        <dd class="col-sm-9">@Model.Ticket?.FromStation?.Name ?? "" → @Model.Ticket?.ToStation?.Name ?? ""</dd>
        <dt class="col-sm-3">Поезд</dt>
        <dd class="col-sm-9">@Model.Ticket?.Train?.Number ?? ""</dd>
    </dl>
</div>

<form method="post">
    <input type="hidden" name="Ticket.Id" value="@(Model.Ticket?.Id ?? 0)" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</form>

