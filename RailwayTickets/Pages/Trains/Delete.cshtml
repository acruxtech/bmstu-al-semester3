@page "{id:int}"
@model RailwayTickets.Pages.Trains.DeleteModel
@{
    ViewData["Title"] = "Удалить поезд";
}

<h1>Удалить поезд</h1>

<h4>Вы уверены, что хотите удалить эту запись?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-3">Номер</dt>
        <dd class="col-sm-9">@Model.Train?.Number ?? ""</dd>
        <dt class="col-sm-3">Модель</dt>
        <dd class="col-sm-9">@Model.Train?.Model ?? ""</dd>
    </dl>
</div>

<form method="post">
    <input type="hidden" name="Train.Id" value="@(Model.Train?.Id ?? 0)" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</form>

