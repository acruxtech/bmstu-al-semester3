@page
@model RailwayTickets.Pages.Trains.IndexModel
@{
    ViewData["Title"] = "Поезда";
}

<h1>Поезда</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить поезд</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Номер</th>
        <th>Модель</th>
        <th>Мест</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Trains)
    {
        <tr>
            <td>@item.Number</td>
            <td>@item.Model</td>
            <td>@item.SeatCount</td>
            <td class="text-end">
                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Изменить</a>
                <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>

