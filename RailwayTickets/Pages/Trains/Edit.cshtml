@page "{id:int}"
@model RailwayTickets.Pages.Trains.EditModel
@{
    ViewData["Title"] = "Редактировать поезд";
}

<h1>Редактировать поезд</h1>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Train.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Train.Number" class="form-label"></label>
        <input asp-for="Train.Number" class="form-control" />
        <span asp-validation-for="Train.Number" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Train.Model" class="form-label"></label>
        <input asp-for="Train.Model" class="form-control" />
        <span asp-validation-for="Train.Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Train.SeatCount" class="form-label"></label>
        <input asp-for="Train.SeatCount" class="form-control" />
        <span asp-validation-for="Train.SeatCount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</form>


